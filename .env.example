# =============================================================================
# SALIS 3 HOTTES — Configuration déploiement
# Copiez ce fichier en `.env` (local) ou configurez ces variables sur Lovable / Cloudflare.
# Ne commitez JAMAIS `.env` avec des secrets.
# =============================================================================

# --- Site public (préfixe VITE_ = exposé au navigateur, OK pour URLs publiques) ---
# URL canonique du site, SANS slash final. Ex: https://www.salis3hottes.fr
VITE_SITE_URL=

# --- Supabase (clé publishable uniquement côté client) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- WhatsApp Business (format international sans + ni espaces). Ex: 33612345678 ---
VITE_WHATSAPP_NUMBER=212669200560

# --- Google Business / avis (lien « Écrire un avis » ou fiche établissement) ---
# Ex: https://g.page/r/XXXX/review  ou  https://maps.google.com/?cid=...
VITE_GOOGLE_REVIEW_URL=
# Fiche publique (optionnel)
VITE_GOOGLE_BUSINESS_URL=

# --- Analytics (Plausible — chargé uniquement après consentement cookies) ---
VITE_PLAUSIBLE_DOMAIN=

# --- Supabase serveur (JAMAIS de préfixe VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Signature des liens d'upload de photos (src/lib/quote.functions.ts) ---
# Secret dédié, distinct des clés Supabase. Générez avec : openssl rand -hex 32
# À défaut, retombe sur SUPABASE_SERVICE_ROLE_KEY (jamais sur la clé publique).
UPLOAD_TOKEN_SECRET=

# --- Emails transactionnels (Resend) — notifications devis ---
RESEND_API_KEY=
RESEND_FROM=Salis 3 Hottes <noreply@votredomaine.fr>
LEAD_NOTIFY_EMAIL=

# --- Assistant chat (optionnel — sinon règles déterministes) ---
# Google AI Studio (Gemini) — prioritaire si renseigné. Clés AQ. : API native uniquement.
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Données entreprise (src/lib/site.ts) ---
# Renseignez aussi dans site.ts : téléphone, email, adresse, SIRET, réseaux sociaux.

# --- Checklist avant mise en ligne ---
# [ ] VITE_SITE_URL défini → npm run generate:seo
# [ ] Migrations Supabase appliquées, y compris 20260927120000 (rate limit) et 20260927120100 (index leads)
# [ ] UPLOAD_TOKEN_SECRET généré (openssl rand -hex 32)
# [ ] RESEND + LEAD_NOTIFY_EMAIL testés (email de test devis)
# [ ] VITE_WHATSAPP_NUMBER testé
# [ ] Mentions légales / confidentialité validées juridiquement
# [ ] Photos réelles remplacent les visuels « Démonstration »
# [ ] Dashboard Supabase Auth : mot de passe min. 12 caractères, protection
#     "leaked password", MFA activé pour les comptes staff (non configurable
#     depuis ce repo — Auth → Policies)
